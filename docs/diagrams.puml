' ---------- 10. SEQUENCE: TEACHER AUTHORING ----------
@startuml SeqTeacherAuthor
actor "Teacher" as T
participant "Proxy" as PX
participant "FastAPI" as API
participant "MinIO" as S3
participant "Celery" as Q
participant "Worker" as W
participant "Gemini" as G
database "PostgreSQL" as DB
T -> API : GET /files/presigned-upload
API --> T : presigned POST (10 MB)
T -> S3 : POST course PDF
T -> PX : POST /exams (require_seb)
PX -> API : + Authorization
API -> DB : insert Exam (PIN)
API --> T : exam_id, PIN
T -> PX : POST /questions/generate
PX -> API : forward
API -> Q : enqueue generate task
API --> T : job_id
W -> S3 : fetch PDF
W -> G : generate MCQ + short-answer
G --> W : structured questions
W -> DB : insert Questions
loop poll every 4s
  T -> API : GET generation-status
  API --> T : pending / completed
end
@enduml

' ---------- 11. SEQUENCE: TEACHER INVIGILATION ----------
@startuml SeqTeacherInvigilate
actor "Instructor" as I
participant "Proxy" as PX
participant "FastAPI" as API
participant "Redis" as R
participant "WS Manager" as WS
database "PostgreSQL" as DB
I -> PX : POST /ws/ticket (exam_id)
PX -> API : + Authorization
API -> API : verify teacher owns exam
API -> R : SET ws_ticket (60s, single-use)
API --> I : ticket
I -> WS : connect /ws/exams/{id}?ticket
WS -> R : GETDEL ticket
WS --> I : subscribed
WS --> I : proctoring_event / attempt_status
I -> PX : GET /attempts/{id}/evidence
PX -> API : forward
API -> DB : fetch captures
API --> I : presigned image URLs
I -> PX : PATCH review (override mark)
PX -> API : forward
API -> DB : update Answer, recompute total
API --> I : updated score
@enduml

' ---------- 12. SEQUENCE: AUTH + TOKEN REFRESH ----------
@startuml SeqAuth
actor "User" as U
participant "/api/backend Proxy" as PX
participant "NextAuth Cookie" as NA
participant "FastAPI" as API
participant "Redis" as R
U -> API : POST /auth/login
API -> R : rate-limit check
API --> U : access (60m) + refresh (rotating)
U -> PX : API request (cookie only)
PX -> NA : decrypt session
alt access valid
  PX -> API : request + Bearer
else access expired
  PX -> API : POST /auth/refresh
  API -> R : check jti, rotate
  API --> PX : new access + refresh
  PX -> PX : re-encode cookie
  PX -> API : retry + new Bearer
end
API --> PX : response
PX --> U : response (token never in JS)
@enduml

' ---------- 13. STATE: QUESTION-GENERATION JOB ----------
@startuml StateJob
[*] --> Pending : enqueued
Pending --> Processing : worker picks up
Processing --> Completed : saved
Processing --> Failed : error
Failed --> Retrying : attempts < 3
Retrying --> Processing : backoff
Failed --> [*] : retries exhausted
Completed --> [*]
@enduml

' ---------- 14. STATE: ANSWER REVIEW ----------
@startuml StateAnswer
[*] --> Unanswered
Unanswered --> Saved : autosave (600ms)
Saved --> Saved : edit again
Saved --> Submitted : attempt submitted
Unanswered --> Submitted : left blank
Submitted --> AIGraded : MCQ / LLM
AIGraded --> TeacherReviewed : override
AIGraded --> [*] : accepted
TeacherReviewed --> [*]
@enduml

' ---------- 15. STATE: WEBSOCKET CONNECTION ----------
@startuml StateWS
[*] --> MintingTicket
MintingTicket --> Connecting : ticket issued
MintingTicket --> Backoff : mint failed
Connecting --> Open : ticket valid
Connecting --> Backoff : rejected (4401)
Open --> Open : ping / pong 25s
Open --> Backoff : dropped
Backoff --> MintingTicket : retry (max 30s)
Open --> Closed : unmount
Closed --> [*]
@enduml

