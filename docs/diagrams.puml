  database "PostgreSQL" as PG
  database "Redis" as RD
  database "MinIO" as MO
}
cloud "Google Gemini API" as EX
BR --> N : HTTPS / WSS
BR --> U : HTTPS / WSS
N --> U : HTTP
U --> PG
U --> RD
U --> MO : S3 API
C --> RD
C --> PG
C --> EX : HTTPS
@enduml
