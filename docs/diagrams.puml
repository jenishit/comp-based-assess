  [NextAuth v5] as AU
}
package "FastAPI" {
  [Routers] as RT
  [Services] as SV
  [Celery Workers] as WK
}
database "PostgreSQL" as PG
database "Redis" as RD
database "MinIO / S3" as S3
cloud "Gemini API" as GM
UI --> HK
HK --> MP
UI --> PX
HK --> RT
PX --> RT
AU --> PX
RT --> SV
RT --> RD
SV --> PG
SV --> S3
WK --> GM
WK --> PG
@enduml

